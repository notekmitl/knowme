{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "THAI_MAHABHUT_PREDICTIVE_RULEBOOK_V2.schema.json",
  "type": "object",
  "required": ["version", "status", "baseCommit", "fixtureIndependence", "predictionContract", "counts", "rules"],
  "properties": {
    "version": { "const": 2 },
    "status": { "type": "string" },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "fixtureIndependence": { "type": "object" },
    "predictionContract": { "type": "object" },
    "counts": { "type": "object" },
    "rules": {
      "type": "array",
      "minItems": 21,
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_type", "source_tier", "source_refs", "applicable_planets", "applicable_taksa_roles", "applicable_mahabhut_status_or_house", "required_conditions", "excluded_conditions", "applicable_domains", "period_applicability", "allowed_conclusions", "prohibited_escalations", "claim_strength", "conflict_priority", "reader_language_boundary", "authority_kind", "evidence_completeness_status"]
      }
    }
  }
}
