{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "status",
    "ownerAuthorization",
    "authorityTiers",
    "independencePolicy",
    "conflictPolicy",
    "readerCopyBoundary",
    "unknownTimePolicy"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "authorityTiers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "tier",
          "id",
          "minimumIndependentSignals",
          "requirements",
          "allowed",
          "prohibited"
        ]
      }
    }
  }
}
