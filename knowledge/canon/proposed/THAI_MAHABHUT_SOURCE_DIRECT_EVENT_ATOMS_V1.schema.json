{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "THAI_MAHABHUT_SOURCE_DIRECT_EVENT_ATOMS_V1",
  "type": "object",
  "required": [
    "version",
    "status",
    "source",
    "coverage",
    "policy",
    "atoms"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "atoms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "atomId",
          "contextId",
          "matrixApplicationId",
          "planet",
          "taksaRole",
          "mahabhutHouse",
          "periodStatus",
          "agePeriod",
          "sourcePages",
          "shortExcerpt",
          "normalizedMeaning",
          "domain",
          "eventFamily",
          "polarity",
          "strength",
          "applicability",
          "prohibitedExtrapolations",
          "visualVerificationStatus",
          "ocrSpanHashes",
          "pageImageHashes"
        ]
      }
    }
  }
}
