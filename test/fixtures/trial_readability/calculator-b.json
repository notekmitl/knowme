symbols":["酉","辰"],"target_element":"metal"},{"kind":"branch_three_harmony","roles":["month","day","annual"],"symbols":["丑","巳","酉"],"target_element":"metal"}]},{"year":2090,"age":101,"pillar_label":"庚戌","stem":"庚","branch":"戌","stem_ten_god":"正财","natal_relations":[{"kind":"stem_clash","roles":["annual","hour"],"symbols":["庚","甲"]},{"kind":"branch_clash","roles":["annual","hour"],"symbols":["戌","辰"]}]},{"year":2091,"age":102,"pillar_label":"辛亥","stem":"辛","branch":"亥","stem_ten_god":"偏财","natal_relations":[{"kind":"branch_clash","roles":["annual","month"],"symbols":["亥","巳"]}]}]}],"method":"lunar_python_yun_traditional_sect_1_v2"},"ambiguities":{"year":false,"month":false,"day":false},"suppressed_fields":[]},"western":{"version":"western_natal_v2","contract_id":"knowme_western_reader_v2","engine_version":"swiss_ephemeris_tropical_placidus_v2","input_hash":"49bb0a91e3df270ff04f3417bf77eaec1bbe87cc5146a98d4f223b15390673da","input":{"birth_date":"1990-05-12","birth_time":"08:15","timezone":"Asia/Bangkok","latitude":18.7883,"longitude":98.9853,"local_civil":"1990-05-12T08:15:00+07:00","utc_instant":"1990-05-12T01:15:00Z","zodiac":"tropical","house_system":"Placidus"},"big3":{"sun":"Taurus","moon":"Sagittarius","rising":"Gemini"},"planets":{"sun":{"sign":"Taurus","longitude":51.069408,"degree":21.0694,"retrograde":false,"house":11},"moon":{"sign":"Sagittarius","longitude":255.512859,"degree":15.5129,"retrograde":false,"house":6},"mercury":{"sign":"Taurus","longitude":38.858371,"degree":8.8584,"retrograde":true,"house":11},"venus":{"sign":"Aries","longitude":8.895457,"degree":8.8955,"retrograde":false,"house":10},"mars":{"sign":"Pisces","longitude":345.770877,"degree":15.7709,"retrograde":false,"house":9},"jupiter":{"sign":"Cancer","longitude":98.896939,"degree":8.8969,"retrograde":false,"house":1},"saturn":{"sign":"Capricorn","longitude":295.298263,"degree":25.2983,"retrograde":true,"house":8}},"houses":{"ascendant":86.101905,"midheaven":346.191854,"cusps":[86.101905,110.821601,136.684675,166.191854,199.685683,234.09999,266.101905,290.821601,316.684675,346.191854,19.685683,54.09999],"system":"Placidus"},"aspects":[{"planet1":"venus","planet2":"jupiter","aspect":"square","angle":90.0,"exact_angle":90,"orb":0.0,"strength":1.0,"tone":"challenging"},{"planet1":"mercury","planet2":"jupiter","aspect":"sextile","angle":60.04,"exact_angle":60,"orb":0.04,"strength":0.994,"tone":"supportive"},{"planet1":"moon","planet2":"mars","aspect":"square","angle":90.26,"exact_angle":90,"orb":0.26,"strength":0.957,"tone":"challenging"},{"planet1":"sun","planet2":"saturn","aspect":"trine","angle":115.77,"exact_angle":120,"orb":4.23,"strength":0.295,"tone":"supportive"},{"planet1":"sun","planet2":"mars","aspect":"sextile","angle":65.3,"exact_angle":60,"orb":5.3,"strength":0.117,"tone":"supportive"}],"interpretations":[{"planet":"sun","en":"Your identity and direction tends to be steady and practical.","th":"ด้านตัวตนและทิศทางชีวิตของคุณมักมั่นคงและยึดสิ่งที่ใช้ได้จริง"},{"planet":"moon","en":"Your emotional needs tends to be future-facing and exploratory.","th":"ด้านความต้องการทางใจของคุณมักมองไกลและต้องการพื้นที่เรียนรู้"},{"planet":"mercury","en":"Your thinking and communication tends to be steady and practical.","th":"ด้านความคิดและการสื่อสารของคุณมักมั่นคงและยึดสิ่งที่ใช้ได้จริง"},{"planet":"venus","en":"Your values and relationships tends to be direct and initiating.","th":"ด้านคุณค่าและความสัมพันธ์ของคุณมักตรงไปตรงมาและชอบเริ่มก่อน"},{"planet":"mars","en":"Your drive and action tends to be intuitive and imaginative.","th":"ด้านแรงขับและการลงมือของคุณมักใช้สัญชาตญาณและจินตนาการสูง"},{"planet":"jupiter","en":"Your growth and perspective tends to be protective and emotionally aware.","th":"ด้านการเติบโตและมุมมองของคุณมักใส่ใจความรู้สึกและความปลอดภัย"},{"planet":"saturn","en":"Your responsibility and long-term lessons tends to be structured and goal-oriented.","th":"ด้านความรับผิดชอบและบทเรียนระยะยาวของคุณมักมีโครงสร้างและจริงจังกับเป้าหมาย"}],"insight":{"en":"You are a Taurus Sun, Sagittarius Moon, and Gemini Rising. Your identity and direction tends to be steady and practical. Your emotional needs tends to be future-facing and exploratory. Your thinking and communication tends to be steady and practical. Your values and relationships tends to be direct and initiating. Your drive and action tends to be intuitive and imaginative. Your growth and perspective tends to be protective and emotionally aware. Your responsibility and long-term lessons tends to be structured and goal-oriented.","th":"คุณเป็นชาวราศีพฤษภ มีดวงจันทร์อยู่ราศีธนู และลัคนาราศีเมถุน ด้านตัวตนและทิศทางชีวิตของคุณมักมั่นคงและยึดสิ่งที่ใช้ได้จริง ด้านความต้องการทางใจของคุณมักมองไกลและต้องการพื้นที่เรียนรู้ ด้านความคิดและการสื่อสารของคุณมักมั่นคงและยึดสิ่งที่ใช้ได้จริง ด้านคุณค่าและความสัมพันธ์ของคุณมักตรงไปตรงมาและชอบเริ่มก่อน ด้านแรงขับและการลงมือของคุณมักใช้สัญชาตญาณและจินตนาการสูง ด้านการเติบโตและมุมมองของคุณมักใส่ใจความรู้สึกและความปลอดภัย ด้านความรับผิดชอบและบทเรียนระยะยาวของคุณมักมีโครงสร้างและจริงจังกับเป้าหมาย"},"analysis":{"elements":{"scores":{"fire":8,"earth":9,"air":4,"water":5},"percentages":{"fire":31,"earth":35,"air":15,"water":19},"dominant":"earth","least":"air"},"modalities":{"scores":{"cardinal":7,"fixed":7,"mutable":12},"percentages":{"cardinal":27,"fixed":27,"mutable":46},"dominant":"mutable","least":"balanced"},"polarities":{"scores":{"positive":12,"negative":14},"percentages":{"positive":46,"negative":54},"dominant":"negative","least":"positive"},"dominant_planets":[{"planet":"venus","score":7.5,"sign":"Aries","house":10,"reasons":{"big3_rulerships":1,"angular":true,"major_aspects":1}},{"planet":"jupiter","score":7.0,"sign":"Cancer","house":1,"reasons":{"big3_rulerships":1,"angular":true,"major_aspects":2}},{"planet":"sun","score":6.0,"sign":"Taurus","house":11,"reasons":{"big3_rulerships":0,"angular":false,"major_aspects":2}}],"house_emphasis":[{"house":11,"score":7},{"house":6,"score":5},{"house":9,"score":3}],"major_aspects":[{"planet1":"venus","planet2":"jupiter","aspect":"square","angle":90.0,"exact_angle":90,"orb":0.0,"strength":1.0,"tone":"challenging"},{"planet1":"mercury","planet2":"jupiter","aspect":"sextile","angle":60.04,"exact_angle":60,"orb":0.04,"strength":0.994,"tone":"supportive"},{"planet1":"moon","planet2":"mars","aspect":"square","angle":90.26,"exact_angle":90,"orb":0.26,"strength":0.957,"tone":"challenging"},{"planet1":"sun","planet2":"saturn","aspect":"trine","angle":115.77,"exact_angle":120,"orb":4.23,"strength":0.295,"tone":"supportive"},{"planet1":"sun","planet2":"mars","aspect":"sextile","angle":65.3,"exact_angle":60,"orb":5.3,"strength":0.117,"tone":"supportive"}]},"reader":{"version":"western_reader_th_v2_r2","overview":{"th":"คุณเป็นคนหนักแน่น ให้ค่ากับความมั่นคง และชอบสร้างผลลัพธ์ที่จับต้องได้ คุณต้องการอิสระในการคิด คนรอบตัวมักเห็นคุณเป็นคนคุยง่าย คล่องตัว และสนใจสิ่งรอบตัวก่อน จึงอาจคิดว่าคุณเปลี่ยนเรื่องเร็วหรือไม่จริงจัง ทั้งที่จริงคุณมีความคิดเห็นและต้องการพื้นที่ตัดสินใจของตัวเอง","en":"Your chart combines a Taurus Sun, Sagittarius Moon, and Gemini Rising. The Thai reading leads with observable behavior and keeps the astrological basis secondary."},"sections":[{"id":"identity","title":"ตัวตนและวิธีตัดสินใจ","body":"เมื่อมีหลายทางให้เลือก คุณมักเทียบว่าทางใดมั่นคง ใช้ได้จริง และคุ้มกับแรงที่ต้องลง ถ้าความคิดกับความรู้สึกไม่ตรงกัน คุณอาจเก็บทุกทางเลือกไว้เพราะยังไม่อยากเสียอิสระในการตัดสินใจ ท่าทีที่คุยง่ายอาจทำให้คนอื่นโยนทางเลือกเพิ่มจนคุณมีข้อมูลมากเกินจำเป็น จุดที่ควรระวังคือปล่อยให้จำนวนทางเลือกหรือความเห็นของคนอื่นยืดเวลาตัดสินใจ วิธีที่เหมาะคือลดให้เหลือไม่เกินสามทาง เขียนผลดีผลเสียของแต่ละทาง แล้วบอกเหตุผลของคุณให้คนที่เกี่ยวข้องรู้","basis":"ดวงอาทิตย์ราศีพฤษภ · ดวงจันทร์ราศีธนู · ลัคนาราศีเมถุน"},{"id":"work","title":"การงานและวิธีทำงาน","body":"เวลาทำงาน คุณคิดเป็นขั้นและต้องเห็นว่าวิธีนั้นใช้ได้จริง เมื่อต้องผลักงานให้เดิน คุณทำได้ดีเมื่อเชื่อมโยงกับความหมาย ความสร้างสรรค์ หรือการช่วยเหลือ คุณทำงานได้ดีเมื่อได้แก้โจทย์ เรียนรู้เร็ว เปลี่ยนบทบาท หรือเชื่อมหลายฝ่าย เรื่องบทบาทอาชีพ ความรับผิดชอบ และผลงานที่คนอื่นเห็นมีน้ำหนักกับคุณมาก คุณจะทำได้ดีเมื่ออำนาจตัดสินใจกับความรับผิดชอบไปด้วยกัน จุดที่ควรระวังคือการรับโจทย์ตามจังหวะถนัดจนลืมเกณฑ์จบงาน ทางที่ช่วยคือกำหนดงานหลักหนึ่งชิ้นและเกณฑ์จบให้ชัดเพื่อไม่ให้การปรับตัวกลายเป็นงานกระจาย","basis":"ดาวพุธราศีพฤษภ · ดาวอังคารราศีมีน · ดาวศุกร์ในเรือน 10"},{"id":"money","title":"การเงินและการใช้ทรัพยากร","body":"เรื่องเงิน คุณให้ค่ากับความคล่องตัวและสิทธิ์เลือกทันที จึงมักตัดสินใจซื้อเร็วเพราะอยากได้ความรู้สึกเดินหน้า เงินร่วม หนี้ ภาษี หรือข้อตกลงระยะยาวต้องการความโปร่งใสเป็นพิเศษ ควรเขียนหน้าที่และทางออกไว้ก่อนผูกทรัพยากรร่วมกัน กำหนดวงเงินก่อนเห็นของที่อยากได้","basis":"ดาวศุกร์ราศีเมษ · ดาวเสาร์ในเรือน 8"},{"id":"love","title":"ความรักและการอยู่ร่วมกัน","body":"ในความสัมพันธ์ คุณแสดงความสนใจตรงและชอบความสัมพันธ์ที่มีชีวิตชีวา และขณะเดียวกันคุณต้องการอิสระในการคิด อีกฝ่ายมักรับรู้ความชัดเจนได้เร็ว บางครั้งคุณอาจอยากใกล้ชิด แต่อีกจังหวะกลับอยากเว้นระยะ จึงควรบอกให้อีกฝ่ายรู้ว่าเวลานั้นต้องการอะไร คุณควรเปิดพื้นที่ให้อีกฝ่ายตอบในจังหวะของเขา","basis":"ดาวศุกร์ราศีเมษ · ดวงจันทร์ราศีธนู · ดาวศุกร์ทำมุม 90°ดาวพฤหัสบดี"},{"id":"wellbeing","title":"การดูแลพลังใจและกิจวัตร","body":"คุณฟื้นพลังได้ดีเมื่อได้เปลี่ยนบรรยากาศ เรียนรู้ หรือมองเรื่องนั้นจากภาพใหญ่ ใจกลับมามีพลังเมื่อเห็นว่าตนยังมีทางเลือก กิจวัตร ภาระประจำ และการแบ่งเวลาพักเป็นเรื่องที่ต้องจัดอย่างตั้งใจ หากตารางแน่นเกินไป พลังที่ใช้กับงานอื่นจะลดลงตามไปด้วย การเปลี่ยนบรรยากาศช่วยพักใจได้ แต่ควรกำหนดเวลากลับมาจัดการเรื่องที่ยังค้าง","basis":"ดวงจันทร์ราศีธนู · ธาตุดิน · ดวงจันทร์ในเรือน 6"},{"id":"strengths","title":"จุดแข็ง","body":"คุณทำเรื่องที่ซับซ้อนให้เป็นระบบและค่อย ๆ สร้างผลที่วัดได้ คุณจึงเหมาะกับงานหรือบทบาทที่ต้องเจรจา ออกแบบประสบการณ์ หรือสร้างความร่วมมือ ก่อนรับงาน ควรถามว่าคุณต้องตัดสินใจเรื่องใด และใครจะนำผลจากงานนั้นไปใช้ต่อ","basis":"ธาตุดิน · ดาวเด่น ดาวศุกร์"},{"id":"cautions","title":"รูปแบบที่ควรระวัง","body":"ความต้องการความแน่นอนอาจทำให้ยื้อวิธีเดิมนานเกินไป บางครั้งสิ่งที่คิดว่าควรทำกับสิ่งที่รู้สึกจริงอาจไม่ตรงกัน เมื่อเกิดความลังเล คุณอาจรีบเลือกเพื่อให้ความอึดอัดจบลง ควรเขียนว่าส่วนใดเป็นข้อเท็จจริงและส่วนใดเป็นความรู้สึกก่อนตอบ","basis":"ธาตุดิน · ดาวศุกร์ทำมุม 90°ดาวพฤหัสบดี"},{"id":"guidance","title":"แนวทางนำไปใช้","body":"กำหนดเวลาหาข้อมูลและวันที่ต้องตัดสินใจ เมื่อเลือกแล้วให้ทำทีละเรื่อง ทบทวนผลก่อนเริ่มทางเลือกใหม่","basis":"ธาตุดิน · จังหวะปรับตัว"}],"method":"คำนวณแบบ Tropical Zodiac ด้วย Swiss Ephemeris ใช้เวลาเกิดท้องถิ่น เขตเวลา IANA พิกัดเกิด ระบบเรือน Placidus และมุมสัมพันธ์หลัก","disclaimer":"ผลนี้เป็นการอ่านแนวโน้มจากดวงกำเนิดเพื่อช่วยทบทวนและวางแผน ไม่ใช่ข้อยืนยันว่าเหตุการณ์ใดต้องเกิดขึ้น"},"overall_summary":{"th":"คุณเป็นคนหนักแน่น ให้ค่ากับความมั่นคง และชอบสร้างผลลัพธ์ที่จับต้องได้ คุณต้องการอิสระในการคิด คนรอบตัวมักเห็นคุณเป็นคนคุยง่าย คล่องตัว และสนใจสิ่งรอบตัวก่อน จึงอาจคิดว่าคุณเปลี่ยนเรื่องเร็วหรือไม่จริงจัง ทั้งที่จริงคุณมีความคิดเห็นและต้องการพื้นที่ตัดสินใจของตัวเอง","en":"Your chart combines a Taurus Sun, Sagittarius Moon, and Gemini Rising. The Thai reading leads with observable behavior and keeps the astrological basis secondary."}}}
