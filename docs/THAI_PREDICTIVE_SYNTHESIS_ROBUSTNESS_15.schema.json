{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "status",
    "scope",
    "profiles",
    "tierDistribution",
    "counts",
    "accuracyClaim",
    "interpretation"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": [
          "profileId",
          "birthTimeMode",
          "age",
          "tierOutcome",
          "readerClaims",
          "independentSignalCount",
          "conflictResult"
        ]
      }
    }
  }
}
