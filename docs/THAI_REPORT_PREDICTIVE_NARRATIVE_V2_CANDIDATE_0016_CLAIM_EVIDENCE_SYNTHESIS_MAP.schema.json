{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "status",
    "fixture",
    "known",
    "unknown",
    "counts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "known": {
      "type": "object",
      "required": [
        "overview",
        "predictions",
        "advice",
        "omissions"
      ]
    },
    "unknown": {
      "type": "object",
      "required": [
        "fixture",
        "predictionClaims",
        "omissions"
      ]
    }
  }
}
