  "overall_topics": [
    {
      "title": "การงาน",
      "collapsed": [
        {
          "id": "overall-topic-1-paragraph-1",
          "text": "คุณมีแนวโน้มทำได้ดีกับงานที่คุณตัดสินใจเองได้และได้ทำกับคนที่ทำงานเก่ง โดยแบ่งกันชัดว่าใครตัดสินใจเรื่องไหน",
          "y": 611,
          "x": 37,
          "width": 316,
          "height": 88
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-1-paragraph-1",
          "text": "คุณมีแนวโน้มทำได้ดีกับงานที่คุณตัดสินใจเองได้และได้ทำกับคนที่ทำงานเก่ง โดยแบ่งกันชัดว่าใครตัดสินใจเรื่องไหน",
          "y": 611,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-1-paragraph-2",
          "text": "เวลาทำงาน คุณทำตามขั้นตอนอย่างสม่ำเสมอ คุณค่อย ๆ เตรียมสิ่งจำเป็นทีละอย่าง",
          "y": 713,
          "x": 37,
          "width": 316,
          "height": 67
        },
        {
          "id": "overall-topic-1-paragraph-3",
          "text": "คุณมองงานทั้งงานและเห็นว่างานแต่ละส่วนเกี่ยวกันอย่างไร คุณเสนอวิธีทำงานที่ต่างจากเดิมได้",
          "y": 816,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-1-paragraph-4",
          "text": "คุณควรตกลงให้ชัดว่างานส่วนไหนเป็นหน้าที่คุณและต้องทำให้ดีแค่ไหน ตกลงด้วยว่าต้องทำอะไรครบจึงถือว่างานเสร็จ",
          "y": 918,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-1-paragraph-5",
          "text": "ถ้าไม่ตกลงเรื่องงานให้ชัด งานที่รับเพิ่มอาจให้ผลงานเป็นชิ้น ๆ ที่ไม่ค่อยต่อกัน",
          "y": 1020,
          "x": 37,
          "width": 316,
          "height": 10
        }
      ],
      "recollapsed": true
    },
    {
      "title": "การเงิน",
      "collapsed": [
        {
          "id": "overall-topic-2-paragraph-1",
          "text": "การเงินของคุณมีแนวโน้มขึ้นอยู่กับงานที่คุณรับผิดชอบและผลงานที่คุณทำได้จริง",
          "y": 453,
          "x": 37,
          "width": 316,
          "height": 58
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-2-paragraph-1",
          "text": "การเงินของคุณมีแนวโน้มขึ้นอยู่กับงานที่คุณรับผิดชอบและผลงานที่คุณทำได้จริง",
          "y": 453,
          "x": 37,
          "width": 316,
          "height": 58
        },
        {
          "id": "overall-topic-2-paragraph-2",
          "text": "เวลาวางแผนการเงิน คุณดูว่าสิ่งที่จะทำมีค่าแค่ไหนและมากเกินไปไหม คุณหาวิธีทำด้วยกันที่ทั้งสองฝ่ายรับได้",
          "y": 525,
          "x": 37,
          "width": 316,
          "height": 89
        },
        {
          "id": "overall-topic-2-paragraph-3",
          "text": "เวลาตัดสินใจเรื่องเงิน คุณนึกถึงสิ่งที่สำคัญกับคุณและความรู้สึก คุณให้ความสำคัญกับการช่วยคนอื่นด้วย",
          "y": 628,
          "x": 37,
          "width": 316,
          "height": 89
        },
        {
          "id": "overall-topic-2-paragraph-4",
          "text": "ถ้าจะเพิ่มเรื่องใหม่เข้าไปในแผนการเงิน คุณควรแยกเงินส่วนตัวออกจากเงินที่ใช้ร่วมกับคนอื่น เหตุผลคือค่าใช้จ่ายจากทีม หุ้นส่วน หรือการขยายงานอาจเพิ่มขึ้นเร็วจนคุณสังเกตไม่ทัน",
          "y": 731,
          "x": 37,
          "width": 316,
          "height": 49
        }
      ],
      "recollapsed": true
    },
    {
      "title": "ความสัมพันธ์",
      "collapsed": [
        {
          "id": "overall-topic-3-paragraph-1",
          "text": "เวลาคบกัน คุณมักให้ความสำคัญกับการเห็นว่ากันและกันมีค่า คุณมักหาวิธีทำอะไรด้วยกันที่ทั้งคู่ยอมรับได้ โดยที่แต่ละฝ่ายไม่ต้องรับมากเกินไป",
          "y": 423,
          "x": 37,
          "width": 316,
          "height": 119
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-3-paragraph-1",
          "text": "เวลาคบกัน คุณมักให้ความสำคัญกับการเห็นว่ากันและกันมีค่า คุณมักหาวิธีทำอะไรด้วยกันที่ทั้งคู่ยอมรับได้ โดยที่แต่ละฝ่ายไม่ต้องรับมากเกินไป",
          "y": 423,
          "x": 37,
          "width": 316,
          "height": 119
        },
        {
          "id": "overall-topic-3-paragraph-2",
          "text": "คุณสังเกตความรู้สึกของคนรักได้แม้เป็นเรื่องเล็ก ๆ และพร้อมอ่อนโยนกับเขา",
          "y": 556,
          "x": 37,
          "width": 316,
          "height": 59
        },
        {
          "id": "overall-topic-3-paragraph-3",
          "text": "เมื่อคุณกับอีกฝ่ายทำตามที่ตกลงกันไว้ คุณทั้งคู่มีแนวโน้มจะค่อย ๆ รู้สึกใกล้ชิดกันมากขึ้น",
          "y": 629,
          "x": 37,
          "width": 316,
          "height": 89
        },
        {
          "id": "overall-topic-3-paragraph-4",
          "text": "คุณกับอีกฝ่ายจะเข้ากันได้ดีขึ้นเมื่อคุยกันให้ชัดว่าจะแบ่งเวลาอย่างไร ใครรับผิดชอบและตัดสินใจเรื่องไหน และแต่ละคนคาดหวังอะไร พอตกลงกันชัด คุณจะดูแลกันได้โดยไม่ต้องคอยเดาว่าอีกฝ่ายต้องการอะไร",
          "y": 732,
          "x": 37,
          "width": 316,
          "height": 48
        }
      ],
      "recollapsed": true
    },
    {
      "title": "ดูแลตัวเองในแต่ละวัน",
      "collapsed": [
        {
          "id": "overall-topic-4-paragraph-1",
          "text": "คุณเริ่มดูแลตัวเองด้วยการใช้ข้อมูล เทียบทางเลือก และคุยให้เข้าใจตรงกัน",
          "y": 590,
          "x": 37,
          "width": 316,
          "height": 60
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-4-paragraph-1",
          "text": "คุณเริ่มดูแลตัวเองด้วยการใช้ข้อมูล เทียบทางเลือก และคุยให้เข้าใจตรงกัน",
          "y": 590,
          "x": 37,
          "width": 316,
          "height": 60
        },
        {
          "id": "overall-topic-4-paragraph-2",
          "text": "การคุยกันให้ทั้งคู่ได้รับความเป็นธรรมและกลับมาอยู่กันในแบบที่ทั้งคู่รับได้ ช่วยให้คุณรู้สึกพร้อมรับมืออีกครั้ง",
          "y": 664,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-4-paragraph-3",
          "text": "ระวังอย่ายึดความคิดเดิมเพียงเพราะคุณมั่นใจหรือเคยชินกับการทำแบบเดิม ลองรับฟังข้อมูลที่ไม่ตรงกับความคิดของคุณ",
          "y": 766,
          "x": 37,
          "width": 316,
          "height": 14
        }
      ],
      "recollapsed": true
    }
