  "overall_topics": [
    {
      "title": "การงาน",
      "collapsed": [
        {
          "id": "overall-topic-1-paragraph-1",
          "text": "คุณมีแนวโน้มทำได้ดีกับงานที่ต้องจัดเงิน เวลา คน และของที่ใช้ทำงานให้ตรงกับที่ลูกค้าต้องการ และดูได้ว่างานช่วยธุรกิจอย่างไร",
          "y": 236,
          "x": 991,
          "width": 452,
          "height": 102
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-1-paragraph-1",
          "text": "คุณมีแนวโน้มทำได้ดีกับงานที่ต้องจัดเงิน เวลา คน และของที่ใช้ทำงานให้ตรงกับที่ลูกค้าต้องการ และดูได้ว่างานช่วยธุรกิจอย่างไร",
          "y": 236,
          "x": 991,
          "width": 452,
          "height": 102
        },
        {
          "id": "overall-topic-1-paragraph-2",
          "text": "เวลาทำงาน คุณใช้สิ่งที่รู้และคิดถึงผลในระยะยาว คุณดูเหตุผลก่อนจะรับงานที่ต้องดูแลเรื่องมากขึ้น",
          "y": 352,
          "x": 991,
          "width": 452,
          "height": 68
        },
        {
          "id": "overall-topic-1-paragraph-3",
          "text": "คุณคิดทีละขั้น คุณต้องเห็นด้วยว่าวิธีที่คิดไว้ใช้กับงานจริงได้",
          "y": 434,
          "x": 991,
          "width": 452,
          "height": 68
        },
        {
          "id": "overall-topic-1-paragraph-4",
          "text": "ควรคุยกันให้ชัดว่าคุณต้องทำส่วนไหน และงานแบบไหนถึงจะเรียกว่าทำได้ดี ตกลงกันด้วยว่าต้องทำอะไรครบจึงจะถือว่างานเสร็จ",
          "y": 516,
          "x": 991,
          "width": 452,
          "height": 102
        },
        {
          "id": "overall-topic-1-paragraph-5",
          "text": "ถ้าคุยกันไม่ชัด งานที่รับเพิ่มอาจกระจายไปหลายเรื่อง จนเอาผลงานจากงานหนึ่งไปใช้ต่อกับอีกงานได้ยาก",
          "y": 632,
          "x": 991,
          "width": 452,
          "height": 68
        }
      ],
      "recollapsed": true
    },
    {
      "title": "การเงิน",
      "collapsed": [
        {
          "id": "overall-topic-2-paragraph-1",
          "text": "การเงินของคุณมีแนวโน้มขึ้นอยู่กับการจัดเวลา เงิน คน และของที่ต้องใช้ เพื่อให้งานได้ผลต่อเนื่อง",
          "y": 493,
          "x": 991,
          "width": 452,
          "height": 68
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-2-paragraph-1",
          "text": "การเงินของคุณมีแนวโน้มขึ้นอยู่กับการจัดเวลา เงิน คน และของที่ต้องใช้ เพื่อให้งานได้ผลต่อเนื่อง",
          "y": 493,
          "x": 991,
          "width": 452,
          "height": 68
        },
        {
          "id": "overall-topic-2-paragraph-2",
          "text": "เวลาวางแผนการเงิน คุณดูว่ารอบตัวมีอะไรเปลี่ยนไปและคนรอบตัวต้องการอะไร",
          "y": 575,
          "x": 991,
          "width": 452,
          "height": 68
        },
        {
          "id": "overall-topic-2-paragraph-3",
          "text": "คุณให้ความสำคัญกับการใช้เงินได้สะดวกและเลือกได้ทันที",
          "y": 657,
          "x": 991,
          "width": 452,
          "height": 68
        },
        {
          "id": "overall-topic-2-paragraph-4",
          "text": "คุณควรกำหนดไว้ล่วงหน้าว่าจะลงทุนได้ไม่เกินเท่าไร และจะหยุดลงทุนในกรณีไหน เหตุผลคือโอกาสใหม่อาจดึงเงินจากงานหลักไปใช้",
          "y": 739,
          "x": 991,
          "width": 452,
          "height": 102
        }
      ],
      "recollapsed": true
    },
    {
      "title": "ความสัมพันธ์",
      "collapsed": [
        {
          "id": "overall-topic-3-paragraph-1",
          "text": "เวลาคบกัน คุณมักใช้สิ่งที่รู้และคิดถึงผลในระยะยาว คุณดูเหตุผลก่อนจะทำอะไรเพิ่มเพื่อให้ความสัมพันธ์ดีขึ้น",
          "y": 716,
          "x": 991,
          "width": 452,
          "height": 68
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-3-paragraph-1",
          "text": "เวลาคบกัน คุณมักใช้สิ่งที่รู้และคิดถึงผลในระยะยาว คุณดูเหตุผลก่อนจะทำอะไรเพิ่มเพื่อให้ความสัมพันธ์ดีขึ้น",
          "y": 716,
          "x": 991,
          "width": 452,
          "height": 68
        },
        {
          "id": "overall-topic-3-paragraph-2",
          "text": "ถ้าสนใจใคร คุณบอกเขาตรง ๆ คุณชอบความสัมพันธ์ที่มีความตื่นเต้น",
          "y": 798,
          "x": 991,
          "width": 452,
          "height": 68
        },
        {
          "id": "overall-topic-3-paragraph-3",
          "text": "เมื่อคุณกับคนที่คบอยู่ทำตามที่ตกลงกันไว้ ทั้งสองคนมีแนวโน้มจะค่อย ๆ รู้สึกใกล้ชิดกันมากขึ้น",
          "y": 880,
          "x": 991,
          "width": 452,
          "height": 31
        },
        {
          "id": "overall-topic-3-paragraph-4",
          "text": "คุณกับคนที่คบอยู่จะเข้ากันได้ดีขึ้น ถ้าคุยกันให้ชัดว่าจะแบ่งเวลาให้กันอย่างไร ใครดูแลเรื่องไหน และเรื่องไหนใครเป็นคนตัดสินใจ",
          "y": 962,
          "x": 991,
          "width": 452,
          "height": 102
        },
        {
          "id": "overall-topic-3-paragraph-5",
          "text": "ควรบอกกันด้วยว่าแต่ละคนอยากให้การคบกันเป็นอย่างไร เมื่อเข้าใจตรงกัน ก็จะดูแลกันได้โดยไม่ต้องคอยเดาใจ",
          "y": 1078,
          "x": 991,
          "width": 452,
          "height": 83
        }
      ],
      "recollapsed": true
    },
    {
      "title": "ดูแลตัวเองในแต่ละวัน",
      "collapsed": [
        {
          "id": "overall-topic-4-paragraph-1",
          "text": "คุณกล้าลงมือทำและรับมือกับเรื่องด่วน",
          "y": 779,
          "x": 991,
          "width": 452,
          "height": 34
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-4-paragraph-1",
          "text": "คุณกล้าลงมือทำและรับมือกับเรื่องด่วน",
          "y": 779,
          "x": 991,
          "width": 452,
          "height": 34
        },
        {
          "id": "overall-topic-4-paragraph-2",
          "text": "การเปลี่ยนบรรยากาศหรือเรียนรู้สิ่งใหม่ ช่วยให้คุณรู้สึกพร้อมรับมืออีกครั้ง",
          "y": 827,
          "x": 991,
          "width": 452,
          "height": 68
        },
        {
          "id": "overall-topic-4-paragraph-3",
          "text": "การมองสิ่งที่เจอให้ครบทุกด้านก็ช่วยให้คุณพร้อมรับมือได้เหมือนกัน",
          "y": 909,
          "x": 991,
          "width": 452,
          "height": 2
        },
        {
          "id": "overall-topic-4-paragraph-4",
          "text": "อย่าเพิ่งคิดว่าความคิดเดิมถูกเสมอ เพียงเพราะคุณมั่นใจหรือเคยทำแบบนี้จนชิน",
          "y": 991,
          "x": 991,
          "width": 452,
          "height": 68
        },
        {
          "id": "overall-topic-4-paragraph-5",
          "text": "ลองฟังข้อมูลที่ต่างจากสิ่งที่คุณคิดไว้ด้วย",
          "y": 1073,
          "x": 991,
          "width": 452,
          "height": 34
        }
      ],
      "recollapsed": true
    }
