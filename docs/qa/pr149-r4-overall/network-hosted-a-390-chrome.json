  "case": "a",
  "overall_topics": [
    {
      "title": "การงาน",
      "collapsed": [
        {
          "id": "overall-topic-1-paragraph-1",
          "text": "คุณมีแนวโน้มทำได้ดีกับงานที่ให้คุณตัดสินใจเองได้ ทำงานกับคนเก่ง และแบ่งกันชัดว่าใครตัดสินใจเรื่องไหน",
          "y": 611,
          "x": 37,
          "width": 316,
          "height": 88
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-1-paragraph-1",
          "text": "คุณมีแนวโน้มทำได้ดีกับงานที่ให้คุณตัดสินใจเองได้ ทำงานกับคนเก่ง และแบ่งกันชัดว่าใครตัดสินใจเรื่องไหน",
          "y": 611,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-1-paragraph-2",
          "text": "เมื่อคุณทำอย่างมีระเบียบและต่อเนื่อง พร้อมค่อย ๆ เตรียมพื้นฐานทีละขั้น คุณมองภาพรวมของงาน เห็นว่างานแต่ละส่วนเกี่ยวกันอย่างไร และเสนอวิธีทำงานแบบใหม่ได้",
          "y": 713,
          "x": 37,
          "width": 316,
          "height": 67
        },
        {
          "id": "overall-topic-1-paragraph-3",
          "text": "คุณควรตกลงให้ชัดว่างานส่วนไหนเป็นหน้าที่คุณ งานต้องดีแค่ไหน และต้องทำอะไรครบจึงถือว่าเสร็จ",
          "y": 847,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-1-paragraph-4",
          "text": "ถ้าไม่ตกลงเรื่องเหล่านี้ งานที่รับเพิ่มอาจกระจายไปหลายทาง แทนที่จะค่อย ๆ รวมเป็นผลงาน",
          "y": 949,
          "x": 37,
          "width": 316,
          "height": 81
        }
      ],
      "recollapsed": true
    },
    {
      "title": "การเงิน",
      "collapsed": [
        {
          "id": "overall-topic-2-paragraph-1",
          "text": "การเงินของคุณมีแนวโน้มขึ้นอยู่กับผลงานที่ทำได้จริงและงานที่คุณรับผิดชอบ",
          "y": 424,
          "x": 37,
          "width": 316,
          "height": 58
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-2-paragraph-1",
          "text": "การเงินของคุณมีแนวโน้มขึ้นอยู่กับผลงานที่ทำได้จริงและงานที่คุณรับผิดชอบ",
          "y": 424,
          "x": 37,
          "width": 316,
          "height": 58
        },
        {
          "id": "overall-topic-2-paragraph-2",
          "text": "เวลาวางแผนเงิน คุณดูว่าอะไรคุ้มค่า อะไรพอดี และจะร่วมมือกันแบบไหนให้ทั้งสองฝ่ายรับได้",
          "y": 496,
          "x": 37,
          "width": 316,
          "height": 89
        },
        {
          "id": "overall-topic-2-paragraph-3",
          "text": "คุณนึกถึงสิ่งที่สำคัญกับคุณ ความรู้สึก และการช่วยคนอื่น",
          "y": 599,
          "x": 37,
          "width": 316,
          "height": 59
        },
        {
          "id": "overall-topic-2-paragraph-4",
          "text": "ถ้าคุณจะขยายแผน ควรแยกเงินส่วนตัวออกจากเงินที่ใช้ร่วมกัน เพราะค่าใช้จ่ายจากทีม หุ้นส่วน หรือการขยายงานอาจเพิ่มเร็วกว่าที่คุณสังเกตเห็น",
          "y": 672,
          "x": 37,
          "width": 316,
          "height": 108
        }
      ],
      "recollapsed": true
    },
    {
      "title": "ความสัมพันธ์",
      "collapsed": [
        {
          "id": "overall-topic-3-paragraph-1",
          "text": "คุณมักให้ความสำคัญกับการเห็นคุณค่าของกันและกัน คุณดูว่าอะไรพอดีและหาวิธีร่วมมือที่ทั้งสองฝ่ายรับได้",
          "y": 423,
          "x": 37,
          "width": 316,
          "height": 88
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-3-paragraph-1",
          "text": "คุณมักให้ความสำคัญกับการเห็นคุณค่าของกันและกัน คุณดูว่าอะไรพอดีและหาวิธีร่วมมือที่ทั้งสองฝ่ายรับได้",
          "y": 423,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-3-paragraph-2",
          "text": "คุณสังเกตความรู้สึกของคนรักได้แม้เป็นเรื่องเล็ก ๆ และพร้อมอ่อนโยนกับเขา",
          "y": 525,
          "x": 37,
          "width": 316,
          "height": 59
        },
        {
          "id": "overall-topic-3-paragraph-3",
          "text": "การทำตามที่ตกลงกันไว้มีแนวโน้มทำให้คุณกับอีกฝ่ายค่อย ๆ ผูกพันกันมากขึ้น",
          "y": 598,
          "x": 37,
          "width": 316,
          "height": 59
        },
        {
          "id": "overall-topic-3-paragraph-4",
          "text": "ความรักจะลงตัวขึ้นเมื่อคุณกับอีกฝ่ายคุยกันชัดเรื่องเวลา หน้าที่ และสิ่งที่คาดหวัง พร้อมตกลงว่าใครรับผิดชอบและตัดสินใจเรื่องไหน การดูแลกันจึงไม่กลายเป็นภาระที่คุณต้องคอยเดาใจอีกฝ่าย",
          "y": 671,
          "x": 37,
          "width": 316,
          "height": 109
        }
      ],
      "recollapsed": true
    },
    {
      "title": "ดูแลตัวเองในแต่ละวัน",
      "collapsed": [
        {
          "id": "overall-topic-4-paragraph-1",
          "text": "คุณเริ่มดูแลตัวเองด้วยการใช้ข้อมูล เทียบทางเลือก และคุยให้เข้าใจตรงกัน",
          "y": 590,
          "x": 37,
          "width": 316,
          "height": 60
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-4-paragraph-1",
          "text": "คุณเริ่มดูแลตัวเองด้วยการใช้ข้อมูล เทียบทางเลือก และคุยให้เข้าใจตรงกัน",
          "y": 590,
          "x": 37,
          "width": 316,
          "height": 60
        },
        {
          "id": "overall-topic-4-paragraph-2",
          "text": "การคุยกันอย่างเป็นธรรมและทำให้ทั้งสองฝ่ายกลับมาอยู่กันได้อย่างพอดี ช่วยให้คุณตั้งหลักได้",
          "y": 664,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-4-paragraph-3",
          "text": "คุณควรระวังการยึดความคิดเดิมเพราะมั่นใจหรือทำจนเคยชิน ลองรับฟังข้อมูลที่แย้งกับความคิดของคุณ",
          "y": 766,
          "x": 37,
          "width": 316,
          "height": 14
        }
      ],
      "recollapsed": true
    }
  ],
