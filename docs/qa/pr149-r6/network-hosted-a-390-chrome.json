  "overall_topics": [
    {
      "title": "การงาน",
      "collapsed": [
        {
          "id": "overall-topic-1-paragraph-1",
          "text": "คุณมีแนวโน้มทำได้ดีกับงานที่คุณตัดสินใจเองได้และได้ทำกับคนที่ทำงานเก่ง โดยแบ่งกันชัดว่าใครตัดสินใจเรื่องไหน",
          "y": 611,
          "x": 37,
          "width": 316,
          "height": 88
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-1-paragraph-1",
          "text": "คุณมีแนวโน้มทำได้ดีกับงานที่คุณตัดสินใจเองได้และได้ทำกับคนที่ทำงานเก่ง โดยแบ่งกันชัดว่าใครตัดสินใจเรื่องไหน",
          "y": 611,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-1-paragraph-2",
          "text": "เวลาทำงาน คุณทำตามขั้นตอนอย่างสม่ำเสมอ คุณค่อย ๆ เตรียมสิ่งจำเป็นทีละอย่าง",
          "y": 713,
          "x": 37,
          "width": 316,
          "height": 67
        },
        {
          "id": "overall-topic-1-paragraph-3",
          "text": "คุณมองงานทั้งงานและเห็นว่างานแต่ละส่วนเกี่ยวกันอย่างไร คุณเสนอวิธีทำงานที่ต่างจากเดิมได้",
          "y": 816,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-1-paragraph-4",
          "text": "ควรคุยกันให้ชัดว่าคุณต้องทำส่วนไหน และงานแบบไหนถึงจะเรียกว่าทำได้ดี ตกลงกันด้วยว่าต้องทำอะไรครบจึงจะถือว่างานเสร็จ",
          "y": 918,
          "x": 37,
          "width": 316,
          "height": 89
        },
        {
          "id": "overall-topic-1-paragraph-5",
          "text": "ถ้าคุยกันไม่ชัด งานที่รับเพิ่มอาจกระจายไปหลายเรื่อง จนเอาผลงานจากงานหนึ่งไปใช้ต่อกับอีกงานได้ยาก",
          "y": 1021,
          "x": 37,
          "width": 316,
          "height": 9
        }
      ],
      "recollapsed": true
    },
    {
      "title": "การเงิน",
      "collapsed": [
        {
          "id": "overall-topic-2-paragraph-1",
          "text": "งานที่คุณรับผิดชอบและผลงานที่ทำได้จริง น่าจะมีผลสำคัญต่อเรื่องเงินของคุณ",
          "y": 453,
          "x": 37,
          "width": 316,
          "height": 59
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-2-paragraph-1",
          "text": "งานที่คุณรับผิดชอบและผลงานที่ทำได้จริง น่าจะมีผลสำคัญต่อเรื่องเงินของคุณ",
          "y": 453,
          "x": 37,
          "width": 316,
          "height": 59
        },
        {
          "id": "overall-topic-2-paragraph-2",
          "text": "เวลาวางแผนการเงิน คุณดูว่าสิ่งที่จะทำมีค่าแค่ไหนและมากเกินไปไหม คุณหาวิธีทำด้วยกันที่ทั้งสองฝ่ายรับได้",
          "y": 526,
          "x": 37,
          "width": 316,
          "height": 89
        },
        {
          "id": "overall-topic-2-paragraph-3",
          "text": "เวลาตัดสินใจเรื่องเงิน คุณนึกถึงสิ่งที่สำคัญกับคุณและความรู้สึก คุณให้ความสำคัญกับการช่วยคนอื่นด้วย",
          "y": 629,
          "x": 37,
          "width": 316,
          "height": 89
        },
        {
          "id": "overall-topic-2-paragraph-4",
          "text": "ควรแยกเงินที่ใช้เองออกจากเงินที่ใช้ร่วมกับคนอื่น ค่าใช้จ่ายจากทีม คนที่ทำธุรกิจร่วมกับคุณ หรือการขยายงาน อาจเพิ่มเร็วจนคุณสังเกตไม่ทัน",
          "y": 732,
          "x": 37,
          "width": 316,
          "height": 48
        }
      ],
      "recollapsed": true
    },
    {
      "title": "ความสัมพันธ์",
      "collapsed": [
        {
          "id": "overall-topic-3-paragraph-1",
          "text": "เวลาคบกัน คุณมักอยากให้ทั้งสองคนเห็นว่าอีกคนสำคัญ เมื่อทำอะไรด้วยกัน คุณมักดูว่าแต่ละคนรับได้แค่ไหน แล้วหาวิธีที่ทั้งคู่ตกลงกันได้",
          "y": 424,
          "x": 37,
          "width": 316,
          "height": 119
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-3-paragraph-1",
          "text": "เวลาคบกัน คุณมักอยากให้ทั้งสองคนเห็นว่าอีกคนสำคัญ เมื่อทำอะไรด้วยกัน คุณมักดูว่าแต่ละคนรับได้แค่ไหน แล้วหาวิธีที่ทั้งคู่ตกลงกันได้",
          "y": 424,
          "x": 37,
          "width": 316,
          "height": 119
        },
        {
          "id": "overall-topic-3-paragraph-2",
          "text": "คุณสังเกตความรู้สึกของคนรักได้แม้เป็นเรื่องเล็ก ๆ และพร้อมอ่อนโยนกับเขา",
          "y": 557,
          "x": 37,
          "width": 316,
          "height": 59
        },
        {
          "id": "overall-topic-3-paragraph-3",
          "text": "เมื่อคุณกับคนที่คบอยู่ทำตามที่ตกลงกันไว้ ทั้งสองคนมีแนวโน้มจะค่อย ๆ รู้สึกใกล้ชิดกันมากขึ้น",
          "y": 630,
          "x": 37,
          "width": 316,
          "height": 89
        },
        {
          "id": "overall-topic-3-paragraph-4",
          "text": "คุณกับคนที่คบอยู่จะเข้ากันได้ดีขึ้น ถ้าคุยกันให้ชัดว่าจะแบ่งเวลาให้กันอย่างไร ใครดูแลเรื่องไหน และเรื่องไหนใครเป็นคนตัดสินใจ",
          "y": 733,
          "x": 37,
          "width": 316,
          "height": 47
        },
        {
          "id": "overall-topic-3-paragraph-5",
          "text": "ควรบอกกันด้วยว่าแต่ละคนอยากให้การคบกันเป็นอย่างไร เมื่อเข้าใจตรงกัน ก็จะดูแลกันได้โดยไม่ต้องคอยเดาใจ",
          "y": 837,
          "x": 37,
          "width": 316,
          "height": 88
        }
      ],
      "recollapsed": true
    },
    {
      "title": "ดูแลตัวเองในแต่ละวัน",
      "collapsed": [
        {
          "id": "overall-topic-4-paragraph-1",
          "text": "คุณใช้ข้อมูล เทียบทางเลือก และคุยให้เข้าใจตรงกัน",
          "y": 591,
          "x": 37,
          "width": 316,
          "height": 59
        }
      ],
      "expanded": [
        {
          "id": "overall-topic-4-paragraph-1",
          "text": "คุณใช้ข้อมูล เทียบทางเลือก และคุยให้เข้าใจตรงกัน",
          "y": 591,
          "x": 37,
          "width": 316,
          "height": 59
        },
        {
          "id": "overall-topic-4-paragraph-2",
          "text": "การคุยกันให้ทั้งคู่ได้รับความเป็นธรรมและกลับมาอยู่กันในแบบที่ทั้งคู่รับได้ ช่วยให้คุณรู้สึกพร้อมรับมืออีกครั้ง",
          "y": 664,
          "x": 37,
          "width": 316,
          "height": 88
        },
        {
          "id": "overall-topic-4-paragraph-3",
          "text": "อย่าเพิ่งคิดว่าความคิดเดิมถูกเสมอ เพียงเพราะคุณมั่นใจหรือเคยทำแบบนี้จนชิน",
          "y": 766,
          "x": 37,
          "width": 316,
          "height": 14
        },
        {
          "id": "overall-topic-4-paragraph-4",
          "text": "ลองฟังข้อมูลที่ต่างจากสิ่งที่คุณคิดไว้ด้วย",
          "y": 839,
          "x": 37,
          "width": 316,
          "height": 29
        }
      ],
      "recollapsed": true
    }
